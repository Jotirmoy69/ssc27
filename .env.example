# Google Identity Services — Web client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Admins (Google emails). Set as many as you need in sequence.
# Each non-empty VITE_ADMIN_EMAIL_N becomes an admin.
# VITE_ADMIN_EMAIL is optional legacy alias for a single admin.
VITE_ADMIN_EMAIL_1=admin1@example.com
VITE_ADMIN_EMAIL_2=admin2@example.com
VITE_ADMIN_EMAIL_3=
VITE_ADMIN_EMAIL_4=
